require "shellwords"

default_platform(:ios)

REPO_ROOT = File.expand_path("..", __dir__)

def resolve_ios_dir(options = {})
  explicit = options[:ios_dir] || ENV["IOS_APP_DIR"]
  unless explicit.to_s.empty?
    return explicit.start_with?("/") ? explicit : File.join(REPO_ROOT, explicit)
  end

  default_ios_dir = File.join(REPO_ROOT, "iosApp")
  return default_ios_dir if Dir.exist?(default_ios_dir)

  spec = Dir.glob(File.join(REPO_ROOT, "**/project.yml"))
            .reject { |p| p.include?("/build/") }
            .first
  return File.dirname(spec) unless spec.nil?

  UI.user_error!("Could not find iOS project directory. Pass ios_dir:<path> (e.g. bundle exec fastlane ios setup ios_dir:iosApp).")
end

platform :ios do
  desc "Install/check local tools and generate Xcode project"
  lane :setup do |options|
    ios_dir = resolve_ios_dir(options)
    sh("git -C #{REPO_ROOT.shellescape} config core.hooksPath .githooks")

    setup_script = File.join(REPO_ROOT, "scripts/setup_tools.sh")
    if File.exist?(setup_script)
      sh("chmod +x #{setup_script.shellescape}")
      sh(setup_script.shellescape)
    else
      sh("command -v brew >/dev/null 2>&1 || (echo 'Homebrew is required.' && exit 1)")
      sh("command -v java >/dev/null 2>&1 || brew install --cask temurin")
      sh("command -v xcodegen >/dev/null 2>&1 || brew install xcodegen")
      sh("command -v swiftgen >/dev/null 2>&1 || brew install swiftgen")
      sh("command -v fastlane >/dev/null 2>&1 || brew install fastlane")
      sh("java -version")
      sh("xcodegen --version")
      sh("swiftgen --version")
      sh("fastlane --version")
    end

    sh("cd #{ios_dir.shellescape} && xcodegen generate")
  end

  desc "Check local tooling and regenerate Xcode project"
  lane :bootstrap do |options|
    ios_dir = resolve_ios_dir(options)
    sh("java -version")
    sh("xcodegen --version")
    sh("cd #{ios_dir.shellescape} && xcodegen generate")
  end

  desc "Regenerate SharkCheapApp.xcodeproj from xcodegen spec"
  lane :generate_xcodeproj do |options|
    ios_dir = resolve_ios_dir(options)
    sh("cd #{ios_dir.shellescape} && xcodegen generate")
  end

  desc "Run shared Kotlin iOS tests"
  lane :test_shared do
    simulator_test_task = `uname -m`.strip == "arm64" ? "iosSimulatorArm64Test" : "iosX64Test"
    sh("cd #{REPO_ROOT.shellescape} && ./gradlew :sharedLogic:#{simulator_test_task} --info")
  end

  desc "Build iOS app for Simulator"
  lane :build_ios do |options|
    ios_dir = resolve_ios_dir(options)
    derived_data_path = File.join(REPO_ROOT, "build/DerivedData")
    sh("xcodebuild -project #{File.join(ios_dir, 'SharkCheapApp.xcodeproj').shellescape} -scheme SharkCheapApp -configuration Debug -destination 'generic/platform=iOS Simulator' -derivedDataPath #{derived_data_path.shellescape} -skipMacroValidation -showBuildTimingSummary build")
  end

  desc "Run project generation, shared tests, and iOS build"
  lane :ci do
    bootstrap
    test_shared
    build_ios
  end

  desc "Bump MARKETING_VERSION and CURRENT_PROJECT_VERSION in Config.xcconfig"
  lane :bump_version do |options|
    ios_dir = resolve_ios_dir(options)
    marketing = options[:marketing]
    build = options[:build]

    UI.user_error!("Pass marketing:<version> (e.g. marketing:1.2.0)") if marketing.to_s.empty?
    UI.user_error!("Pass build:<number> (e.g. build:42)") if build.to_s.empty?

    path = File.join(ios_dir, "Configuration/Config.xcconfig")
    content = File.read(path)
    content.gsub!(/^MARKETING_VERSION=.*/, "MARKETING_VERSION=#{marketing}")
    content.gsub!(/^CURRENT_PROJECT_VERSION=.*/, "CURRENT_PROJECT_VERSION=#{build}")
    File.write(path, content)

    UI.success("Updated #{path} -> MARKETING_VERSION=#{marketing}, CURRENT_PROJECT_VERSION=#{build}")
  end
end
