require "shellwords"

default_platform(:ios)

def resolve_ios_dir!
  candidates = Dir.glob("**/project.yml").reject { |p| p.start_with?("build/") }
  ios_project = candidates.find { |p| p.include?("/iosApp/") || p.start_with?("iosApp/") } || candidates.first
  UI.user_error!("Could not find project.yml for XcodeGen. Expected something like iosApp/project.yml") if ios_project.nil?
  File.dirname(ios_project)
end

platform :ios do
  desc "Install/check local tools and generate Xcode project"
  lane :setup do
    ios_dir = resolve_ios_dir!
    sh("git config core.hooksPath .githooks")

    if File.exist?("./scripts/setup_tools.sh")
      sh("chmod +x ./scripts/setup_tools.sh")
      sh("./scripts/setup_tools.sh")
    else
      sh("command -v brew >/dev/null 2>&1 || (echo 'Homebrew is required.' && exit 1)")
      sh("command -v java >/dev/null 2>&1 || brew install --cask temurin")
      sh("command -v xcodegen >/dev/null 2>&1 || brew install xcodegen")
      sh("command -v fastlane >/dev/null 2>&1 || brew install fastlane")
      sh("java -version")
      sh("xcodegen --version")
      sh("fastlane --version")
    end

    sh("cd #{Shellwords.escape(ios_dir)} && xcodegen generate")
  end

  desc "Check local tooling and regenerate Xcode project"
  lane :bootstrap do
    ios_dir = resolve_ios_dir!
    sh("java -version")
    sh("xcodegen --version")
    sh("cd #{Shellwords.escape(ios_dir)} && xcodegen generate")
  end

  desc "Regenerate SharkCheapApp.xcodeproj from xcodegen spec"
  lane :generate_xcodeproj do
    ios_dir = resolve_ios_dir!
    sh("cd #{Shellwords.escape(ios_dir)} && xcodegen generate")
  end

  desc "Run shared Kotlin iOS tests"
  lane :test_shared do
    sh("./gradlew :sharedLogic:iosSimulatorArm64Test")
  end

  desc "Build iOS app for Simulator"
  lane :build_ios do
    ios_dir = resolve_ios_dir!
    project_path = File.join(ios_dir, "SharkCheapApp.xcodeproj")
    sh("xcodebuild -project #{Shellwords.escape(project_path)} -scheme SharkCheapApp -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' build")
  end

  desc "Run project generation, shared tests, and iOS build"
  lane :ci do
    bootstrap
    test_shared
    build_ios
  end

  desc "Bump MARKETING_VERSION and CURRENT_PROJECT_VERSION in Config.xcconfig"
  lane :bump_version do |options|
    ios_dir = resolve_ios_dir!
    marketing = options[:marketing]
    build = options[:build]

    UI.user_error!("Pass marketing:<version> (e.g. marketing:1.2.0)") if marketing.to_s.empty?
    UI.user_error!("Pass build:<number> (e.g. build:42)") if build.to_s.empty?

    path = File.join(ios_dir, "Configuration/Config.xcconfig")
    content = File.read(path)
    content.gsub!(/^MARKETING_VERSION=.*/, "MARKETING_VERSION=#{marketing}")
    content.gsub!(/^CURRENT_PROJECT_VERSION=.*/, "CURRENT_PROJECT_VERSION=#{build}")
    File.write(path, content)

    UI.success("Updated #{path} -> MARKETING_VERSION=#{marketing}, CURRENT_PROJECT_VERSION=#{build}")
  end
end

